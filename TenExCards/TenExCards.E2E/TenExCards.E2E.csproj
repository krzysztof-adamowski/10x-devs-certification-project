<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- NO ProjectReference to TenExCards.csproj — DELIBERATE. This suite drives the application over
       HTTP as a learner does, not in process. Referencing it would let a test reach past the browser
       into application types and quietly stop being an end-to-end test. -->

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- AwesomeAssertions, never FluentAssertions — a licensing rule, see TenExCards/AGENTS.md.
         Versions match TenExCards.Tests; Playwright 1.62.0 confirmed with `dotnet package search`
         on 2026-09-13. -->
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>

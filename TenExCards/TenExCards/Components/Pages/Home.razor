@page "/"
@attribute [AllowAnonymous]
@using TenExCards.Components.Account

<PageTitle>10xCards</PageTitle>

<h1>10xCards</h1>

<StatusMessage />

<p>
    Turn a passage you have just read into flashcards worth keeping.
</p>

<AuthorizeView>
    <Authorized>
        <p>Signed in as <strong>@context.User.Identity?.Name</strong>.</p>
        <p>
            <a class="btn btn-primary" href="generate">Generate cards from a passage</a>
        </p>
    </Authorized>
    <NotAuthorized>
        <p>
            <a href="Account/Register">Register</a> or <a href="Account/Login">sign in</a> to get
            started.
        </p>
    </NotAuthorized>
</AuthorizeView>

@page "/"
@attribute [AllowAnonymous]
@using TenExCards.Components.Account

<PageTitle>10xCards</PageTitle>

<h1>10xCards</h1>

<StatusMessage />

<p>
    Turn a passage you have just read into flashcards worth keeping.
</p>

<p>
    The application shell is in place. Pasting a passage, reviewing candidates, and saving the
    cards you accept arrive in later slices.
</p>

<AuthorizeView>
    <Authorized>
        <p>Signed in as <strong>@context.User.Identity?.Name</strong>.</p>
    </Authorized>
    <NotAuthorized>
        <p>
            <a href="Account/Register">Register</a> or <a href="Account/Login">sign in</a> to get
            started.
        </p>
    </NotAuthorized>
</AuthorizeView>

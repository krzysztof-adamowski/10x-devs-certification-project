@page "/generate"
@rendermode InteractiveServer
@using TenExCards.Data

<PageTitle>Generate cards</PageTitle>

<h1>Generate cards</h1>

@if (_stage is Stage.Composing or Stage.Failed)
{
    @if (_stage is Stage.Failed && _failureMessage is not null)
    {
        <div class="alert alert-warning" role="alert">@_failureMessage</div>
    }

    @if (_validationMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@_validationMessage</div>
    }

    <p>
        Paste a passage you have just read. Every card is made from this text alone, and the text
        itself is discarded as soon as the candidates exist.
    </p>

    <div class="mb-3">
        <label for="passage" class="form-label">Passage</label>
        <textarea id="passage" class="form-control" rows="12"
                  @bind="_passage" @bind:event="oninput"></textarea>
        <div class="form-text @(PassageOverLimit ? "text-danger" : null)">
            @_passage.Length.ToString("N0") / @Options.MaxPassageCharacters.ToString("N0") characters
        </div>
    </div>

    <div class="mb-3">
        <label for="focus" class="form-label">Focus hint (optional)</label>
        <input id="focus" class="form-control" maxlength="@Options.MaxFocusHintCharacters"
               placeholder="the causes, not the dates"
               @bind="_focusHint" @bind:event="oninput" />
        <div class="form-text @(FocusHintOverLimit ? "text-danger" : null)">
            @_focusHint.Length / @Options.MaxFocusHintCharacters characters. Narrows what gets carded.
        </div>
    </div>

    <button class="btn btn-primary" disabled="@(!CanSubmit || _busy)" @onclick="SubmitAsync">
        Generate cards
    </button>
}
else if (_stage is Stage.Generating)
{
    <p>Reading your passage and writing cards.</p>

    <div class="progress mb-3" role="progressbar" aria-label="Generating">
        <div class="progress-bar progress-bar-striped progress-bar-animated w-100"></div>
    </div>

    <p class="text-muted">
        @_elapsedSeconds second@(_elapsedSeconds == 1 ? "" : "s") elapsed@(_chunks > 0 ? $", {_chunks} response chunk{(_chunks == 1 ? "" : "s")} received" : "").
    </p>

    <button class="btn btn-outline-secondary" @onclick="CancelAsync">Cancel</button>
}
else if (_stage is Stage.Triaging && _session is { IsComplete: false })
{
    <p class="text-muted">Card @_session.Position of @_session.BatchSize</p>

    @if (_saveError is not null)
    {
        <div class="alert alert-danger" role="alert">@_saveError</div>
    }

    @if (_editValidationMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@_editValidationMessage</div>
    }

    <div class="card mb-3">
        <div class="card-body">
            @if (_editing)
            {
                <div class="mb-3">
                    <label for="edit-prompt" class="form-label">Prompt</label>
                    <textarea id="edit-prompt" class="form-control" rows="3"
                              @bind="_editPrompt" @bind:event="oninput"></textarea>
                    <div class="form-text @(EditPromptOverLimit ? "text-danger" : null)">
                        @_editPrompt.Length.ToString("N0") / @CardBounds.MaxPromptCharacters.ToString("N0") characters
                    </div>
                </div>

                <div>
                    <label for="edit-answer" class="form-label">Answer</label>
                    <textarea id="edit-answer" class="form-control" rows="5"
                              @bind="_editAnswer" @bind:event="oninput"></textarea>
                    <div class="form-text @(EditAnswerOverLimit ? "text-danger" : null)">
                        @_editAnswer.Length.ToString("N0") / @CardBounds.MaxAnswerCharacters.ToString("N0") characters
                    </div>
                </div>
            }
            else
            {
                <h2 class="card-title h5">@Current.Prompt</h2>
                <p class="card-text">@Current.Answer</p>
            }
        </div>
    </div>

    <div class="d-flex gap-2 mb-3">
        @if (_editing)
        {
            <button class="btn btn-primary" style="min-width: 10rem" disabled="@(_busy || !CanCommitEdit)" @onclick="AcceptAsync">Keep this card</button>
            <button class="btn btn-primary" style="min-width: 10rem" disabled="@_busy" @onclick="CancelEdit">Cancel</button>
        }
        else
        {
            <button class="btn btn-primary" style="min-width: 10rem" disabled="@_busy" @onclick="AcceptAsync">Keep this card</button>
            <button class="btn btn-primary" style="min-width: 10rem" disabled="@_busy" @onclick="RejectAsync">Discard this card</button>
            <button class="btn btn-primary" style="min-width: 10rem" disabled="@_busy" @onclick="BeginEdit">Edit wording</button>
        }
    </div>

    @if (_busy)
    {
        <p class="text-muted">Saving…</p>
    }

    <p class="text-muted">
        Cards you have not decided on are discarded when you leave this page. They cannot be
        brought back.
    </p>
}
else if (_stage is Stage.Summary)
{
    <p>
        Saved @_session!.Saved card@(_session.Saved == 1 ? "" : "s"), discarded @_session.Discarded.
    </p>

    <button class="btn btn-primary" @onclick="StartOver">Paste another passage</button>
    <a class="btn btn-outline-secondary ms-2" href="cards">Your cards</a>
}

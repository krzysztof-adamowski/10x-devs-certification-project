{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Generation": {
    "MaxPassageCharacters": 12000,
    "MaxFocusHintCharacters": 200,
    "MinCandidates": 3,
    "MaxCandidates": 12,
    "WordsPerCandidate": 200,
    "MaxPromptCharacters": 500,
    "MaxAnswerCharacters": 1000,
    "TimeoutSeconds": 30
  },

  "Gemini": {
    "Models": [
      "gemini-3.8-flash",
      "gemini-3.5-flash-lite",
      "gemini-3.1-flash-lite"
    ],
    "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/"
  }
}
